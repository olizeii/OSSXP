# ─── OSSXP Server-Konfiguration ───────────────────────────────
# Kopieren nach server/.env und Werte anpassen.

PORT=3001
NODE_ENV=development

# Geheimnis für die Login-Tokens (JWT). In Produktion PFLICHT!
# Erzeugen z. B. mit: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Schlüssel, mit dem die Untis-Passwörter in der Datenbank verschlüsselt werden (AES-256-GCM).
# In Produktion PFLICHT – wird er geändert, müssen alle Nutzer Untis neu verknüpfen.
UNTIS_SECRET=

# Cookies nur über HTTPS senden (auf true setzen, sobald die Seite hinter HTTPS läuft)
COOKIE_SECURE=false

# SQLite-Datei (relativ zum server/-Ordner)
DB_FILE=./data/ossxp.db

# Untis-Demo-Modus: akzeptiert beliebige Zugangsdaten und liefert einen Beispiel-Stundenplan
UNTIS_MOCK=false

# Chat-Channels (der erste ist der allgemeine Startchannel)
CHAT_CHANNELS=allgemein,schule,gaming,offtopic

# Optionale Twitch-User-IDs, deren 7TV-/BTTV-Channel-Emotes zusätzlich geladen werden
# (kommagetrennt, z. B. 22484632)
EMOTE_TWITCH_IDS=
