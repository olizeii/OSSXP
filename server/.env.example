# ─── OSSXP Server-Konfiguration ───────────────────────────────
# Kopieren nach server/.env und Werte anpassen.

PORT=3001
NODE_ENV=development

# Geheimnis für die Login-Tokens (JWT). In Produktion PFLICHT!
# Erzeugen z. B. mit: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Schlüssel, mit dem die Untis-Passwörter in der Datenbank verschlüsselt werden (AES-256-GCM).
# In Produktion PFLICHT – wird er geändert, müssen alle Nutzer Untis neu verknüpfen.
UNTIS_SECRET=

# Cookies nur über HTTPS senden (auf true setzen, sobald die Seite hinter HTTPS läuft)
COOKIE_SECURE=false

# SQLite-Datei (relativ zum server/-Ordner)
DB_FILE=./data/ossxp.db

# Untis-Demo-Modus: akzeptiert beliebige Zugangsdaten und liefert einen Beispiel-Stundenplan
UNTIS_MOCK=false

# Benutzernamen mit Admin-Rechten (NewsXP veröffentlichen, MollyXP-Uploads löschen), kommagetrennt
ADMIN_USERNAMES=

# Ordner für hochgeladene Dateien (MollyXP, NewsXP), relativ zum server/-Ordner
UPLOAD_DIR=./data/uploads

# Lehrerverzeichnis für volle Namen zu Untis-Kürzeln. HTL Hollabrunn ist voreingestellt;
# weitere Schulen: TEACHER_DIRECTORY_<UNTIS-SCHULNAME>=url (Bindestriche als _)
# TEACHER_DIRECTORY_HTL_HL=https://www.htl-hl.ac.at/services/teachers/teachers.php
# Manuelle Korrekturen der Zuordnung:
UNTIS_TEACHER_NAMES=

# Zeitzone der Schule (für „Wo ist … gerade?“, freie Räume, Dashboard)
UNTIS_TIMEZONE=Europe/Vienna

# Chat-Channels (der erste ist der allgemeine Startchannel)
CHAT_CHANNELS=allgemein,schule,gaming,offtopic

# Twitch-User-IDs, deren 7TV-/BTTV-/FFZ-Channel-Emotes geladen werden (kommagetrennt).
# Leer = Standard (NymN, xQc, LIRIK, MOONMOON, forsen → mehrere Tausend Emotes).
# Weitere Emotes können User im Chat über die 7TV-Suche für alle hinzufügen.
EMOTE_TWITCH_IDS=

# Start-Admin (wird angelegt, falls es noch keinen Admin gibt). Im Dev-Modus Standard: admin / admin1234
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
