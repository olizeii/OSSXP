{
  "name": "ossxp",
  "version": "0.1.0",
  "private": true,
  "description": "OSSXP – eine Web-Desktop-Umgebung im Windows-XP-Design",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm start -w server",
    "typecheck": "npm run typecheck -w client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
